{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everup-quiz-cloud",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "assets": {"directory": "./public", "binding": "STATIC", "run_worker_first": true},
  "d1_databases": [{"binding":"DB","database_name":"everup-quiz","database_id":"INSERISCI_ID_D1","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"MEDIA","bucket_name":"everup-quiz-media"}]
}
